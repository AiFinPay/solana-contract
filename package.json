{
	"scripts": {
		"test:ts": "tsc && mocha target/tests/**/*.js",
		"test:ts:localnet": "ANCHOR_PROVIDER_URL=http://localhost:8899 ANCHOR_WALLET=~/.config/solana/id.json mocha target/tests/**/*.js",
		"check:devnet": "node target/scripts/check-devnet-splitter.js",
		"build:check-devnet": "tsc scripts/devnet/check-devnet-splitter.ts --target ES2020 --module commonjs --esModuleInterop --skipLibCheck --ignoreConfig --types node --outDir target/scripts",
		"initialize:devnet": "node target/scripts/initialize-devnet-splitter.js",
		"build:initialize-devnet": "tsc scripts/devnet/initialize-devnet-splitter.ts --target ES2020 --module commonjs --esModuleInterop --skipLibCheck --ignoreConfig --types node --outDir target/scripts",
		"configure:devnet": "node target/scripts/configure-route.js",
		"build:configure-devnet": "tsc scripts/devnet/configure-route.ts --target ES2020 --module commonjs --esModuleInterop --skipLibCheck --ignoreConfig --types node --outDir target/scripts"
	},
	"devDependencies": {
		"@coral-xyz/anchor": "^0.32.1",
		"@coral-xyz/borsh": "^0.32.1",
		"@daochild/agents-config": "^1.2.1",
		"@noble/curves": "^2.4.0",
		"@solana/kit": "^8.2.0",
		"@solana/kit-plugin-rpc": "^0.19.0",
		"@solana/kit-plugin-signer": "^0.19.0",
		"@solana/web3.js": "^1.98.4",
		"@types/bn.js": "^5.2.0",
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.4.1",
		"c8": "^12.0.0",
		"chai": "^6.2.2",
		"mocha": "^12.0.0",
		"ts-node": "10.9.2",
		"typescript": "^7.0.2"
	}
}
