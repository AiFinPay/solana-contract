{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "autoupdate": "notify",
  "snapshot": true,
  "permission": {
    "bash": {
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git commit*": "deny",
      "git revert*": "deny",
      "git reset*": "deny",
      "git rebase*": "deny",
      "git push*": "deny",
      "git cherry-pick*": "deny",
      "git merge*": "deny",
      "git pull*": "deny",
      "git fetch*": "deny",
      "git checkout*": "deny",
      "git branch*": "deny",
      "git tag*": "deny",
      "git rm*": "deny",
      "git restore*": "deny",
      "git stash*": "deny",
      "rm *": "deny",
      "rmdir *": "deny",
      "sudo*": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "fdisk*": "deny",
      "halt*": "deny",
      "reboot*": "deny",
      "shutdown*": "deny",
      "poweroff*": "deny",
      "kill*": "deny",
      "pkill*": "deny",
      "killall*": "deny",
      "passwd*": "deny",
      "chpasswd*": "deny",
      "useradd*": "deny",
      "usermod*": "deny",
      "userdel*": "deny",
      "groupadd*": "deny",
      "groupdel*": "deny",
      "apt-get*": "deny",
      "apt*": "deny",
      "yum*": "deny",
      "dnf*": "deny",
      "pacman*": "deny",
      "*": "ask"
    },
    "read": "allow",
    "edit": {
      "**/.env*": "ask",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.kube/**": "deny",
      "~/.config/opencode/**": "allow",
      "*": "allow"
    },
    "external_directory": {
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.kube/**": "deny",
      "~/secrets/**": "deny",
      "*": "ask"
    },
    "webfetch": "ask",
    "task": "ask",
    "skill": "allow"
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
