# AiFinPay Solana Splitter v1.4 — Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env to version control.

# ─── RPC ────────────────────────────────────────────────────────────────────
# Solana cluster endpoint (default: devnet public)
# SOLANA_RPC_URL=https://api.devnet.solana.com

# ─── Deployer wallet ────────────────────────────────────────────────────────
# Keypair JSON that pays for the initialize transaction.
# Generate: solana-keygen new --no-passphrase -s -o <path>/file_name.json
DEPLOYER_KEYPAIR_PATH=

# ─── RBAC roles (all three must be distinct addresses) ──────────────────────

# Admin — full control over config, routes, tokens, pausing
ADMIN_PUBKEY=

# Pauser — can pause / unpause the program
PAUSER_PUBKEY=

# Treasury — receives treasury fees from settlements
TREASURY_PUBKEY=

# Signer — secp256k1 uncompressed public key (64 bytes, 128 hex chars)
# Used for ECDSA signature verification in settle_* instructions.
# Generate:
#   openssl ecparam -genkey -name secp256k1 -noout -out signer.pem
#   openssl ec -in signer.pem -pubout -outform DER | tail -c 64 | xxd -p -c 128
SIGNER_PUBKEY=

# ─── Whitelisted stablecoin mints (optional, comma-separated) ───────────────
# Example (devnet): USDC, USDT
## Use Circle offial stablecoin https://faucet.circle.com/ https://explorer.solana.com/address/4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU?cluster=devnet

# STABLECOINS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v,Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# ─── Route configuration (optional) ─────────────────────────────────────────
# Valid values: AGENT_X402, MERCHANT_AIFP1 (must match EVM v1.4 constants)
ROUTE_IDS=AGENT_X402,MERCHANT_AIFP1

# Fee basis points per route (comma-separated, must match ROUTE_IDS length)
# Treasury BPS — max 500 (5%) per route
TREASURY_BPS=100,100

# IP Creator BPS — max 100 (1%) per route
IP_CREATOR_BPS=50,50
